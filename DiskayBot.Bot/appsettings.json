{
    "Serilog": {
        "MinimumLevel": {
            "Default": "Debug",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:dd.MM.yy -> HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
                }
            }
        ]
    },
    "Configuration": {
        "Services": {
            "Default": {
                "DiskayMemory": {
                    "url": "http://localhost:5014"
                },
                "Redis": {
                    "url": "localhost:6379"
                },
                "ScheduleService": {
                    "url": "https://portal.it-college.ru"
                }  
            },
            "Docker": {
                "DiskayMemory": {
                    "url": "http://diskay_memory:8080"
                },
                "Redis": {
                    "url": "redis:6379"
                },
                "ScheduleService": {
                    "url": "https://portal.it-college.ru"
                }
            }
        }
    }
}